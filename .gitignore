# ---- Build artifacts ----
/build/
/build-*/
/out/
/cmake-build-*/
codegen/__pycache__
scripts/__pycache__

# ---- Documentation output ----
# Doxygen renders into html/ in the source tree via the `rpg_os_docs` CMake
# target (or the "Build Documentation" VS Code task). It is generated, so it
# must never be committed.
/html/

# ---- Web demo (CI-generated assets) ----
# The ELO Arena demo page. The WASM module, the rulesets, and the leaderboards
# are produced by CI (the deploy-demo job of docs.yml) at deploy time; only
# the static page sources are committed.
/web/demo/data/
/web/demo/rulesets/
/web/demo/wasm/

# ---- npm package build output ----
# The @mundus-mirabilis/rpg-os package is assembled by wasm/build.sh; its
# dist (WASM module), rulesets, and LICENSE are generated, never committed.
/wasm/package/dist/
/wasm/package/rulesets/
/wasm/package/LICENSE

# ---- Tooling ----
compile_commands.json
.cache/
.clangd/

# ---- IDE / editors ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Local ressources ----
.local_ressources
